/workloads/vllm/vllm/**/*.so
/workloads/vllm/vllm/**/*.o
/workloads/vllm/vllm/**/*.obj

# Global: never commit local virtual environments
.venv/
venv/

# Global: Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Global: build output directories
build/
dist/
out/
.output/
cmake-build-*/
CMakeFiles/
.tmp_versions/

# Global: compiler/linker/module artifacts
*.o
*.obj
*.a
*.la
*.lo
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exp
*.pyd
*.ko
*.mod
*.mod.c
.*.cmd
Module.symvers
modules.order

# Global: profiling and debug artifacts
*.dSYM/
*.gcda
*.gcno
*.prof
*.profraw
*.profdata
*.log

# Large local datasets (do not commit)
/workloads/vllm/datasets/
workloads/vllm/results/uvm_kv_bench_single_process.log

# vLLM experiment outputs (do not commit generated logs/summaries/traces)
/workloads/vllm/log/
/workloads/vllm/results/
/workloads/vllm/**/real_residency*.json
/workloads/vllm/**/real_residency*.jsonl
/workloads/vllm/**/*_summary.json
/workloads/vllm/**/*_summary.csv
/workloads/vllm/**/*_metrics.json
/workloads/vllm/**/*_trace.jsonl
/workloads/vllm/**/*_stats.json

# UVM experiment outputs
/results/

# Per-run experiment captures can contain model paths, hardware metadata, and
# hundreds of megabytes of logs. Keep source, frozen plans, and written
# reports in git, but never the generated run directories.
**/artifacts/
/experiments/uvm_static_alias_original_va/result*.json

# Written experiment outcomes stay off the main branch. Reproduction
# protocols under experiments/reproduce/ remain tracked.
/experiments/eurosys_moe_offload_evaluation/RESULTS*.md
/experiments/eurosys_moe_offload_evaluation/REPORT*.md
/experiments/eurosys_moe_offload_evaluation/ERROR_FIX_LOG*.md
/experiments/eurosys_moe_offload_evaluation/UNRESOLVED*.md
/experiments/eurosys_moe_offload_evaluation/EXPERIMENT_FAILURE_CAUSES_AND_SOLUTIONS.md

# Generated benchmark/result artifacts
/log/
**/result/
**/results/
**/xcoord_results/
**/results_phase_detection/
/workloads/vllm/results*/
/workloads/vllm/uvm/results-*/
**/vllm_uvm_*.jsonl
**/vllm_uvm_*.log

# Locally compiled UVM probe executable (keep the .cu source only)
/workloads/vllm/vllm/uvm_test/managed_to_cuda_malloc_reuse_probe

# Local manuscript copies and editor state (keep the files on disk).
/.vscode/
/AdaptMoE__*.pdf
/my_paper/
/my_paper.zip
/paper/*.pdf
/paper/eurosys.bib

